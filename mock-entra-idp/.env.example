# Mock Entra ID Configuration
MOCK_TENANT_ID=12345678-1234-1234-1234-123456789abc
MOCK_IDP_HOST=0.0.0.0
MOCK_IDP_PORT=8001
MOCK_IDP_BASE_URL=http://localhost:8001

# Token Configuration
ACCESS_TOKEN_TTL=3600        # 1 hour
REFRESH_TOKEN_TTL=86400      # 24 hours
AUTH_CODE_TTL=600            # 10 minutes

# Pre-seeded Test Users
TEST_USERS=testuser@example.com,admin@example.com,demo@example.com

# Pre-registered Clients
VSCODE_CLIENT_ID=11111111-1111-1111-1111-111111111111
CLAUDE_CODE_CLIENT_ID=33333333-3333-3333-3333-333333333333
CONFIDENTIAL_CLIENT_ID=66666666-6666-6666-6666-666666666666
CONFIDENTIAL_CLIENT_SECRET=test-secret-123
SERVICE_PRINCIPAL_CLIENT_ID=77777777-7777-7777-7777-777777777777
SERVICE_PRINCIPAL_CLIENT_SECRET=test-sp-secret-456

# MCP Server Configuration (for token audience)
MCP_SERVER_APP_ID=api://mcp-server
DEFAULT_SCOPE=api://mcp-server/.default

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Storage Backend
STORAGE_BACKEND=memory  # or "redis"
REDIS_URL=redis://localhost:6379/1
