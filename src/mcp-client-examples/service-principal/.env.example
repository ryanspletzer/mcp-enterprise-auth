# Entra ID Service Principal Configuration
CLIENT_ID=your-service-principal-client-id-here
CLIENT_SECRET=your-service-principal-client-secret-here
TENANT_ID=your-tenant-id-here

# MCP Server Configuration
MCP_SERVER_URL=http://localhost:8000

# OAuth Configuration
# Use .default to request all configured application permissions
SCOPE=api://mcp-server/.default
