# Entra ID Configuration (shared across all clients)
TENANT_ID=your-tenant-id-here

# Service Principal Configuration (for service-principal client)
SP_CLIENT_ID=your-service-principal-client-id-here
SP_CLIENT_SECRET=your-service-principal-secret-here

# Public Client Configuration (for public-client-with-creds)
PUBLIC_CLIENT_ID=your-public-client-id-here

# Confidential Client Configuration (for confidential-client)
CONFIDENTIAL_CLIENT_ID=your-confidential-client-id-here
CONFIDENTIAL_CLIENT_SECRET=your-confidential-client-secret-here

# MCP Server DCR Configuration (for public-client-no-creds)
VSCODE_CLIENT_ID=your-vscode-client-id-here
CLAUDE_DESKTOP_CLIENT_ID=your-claude-desktop-client-id-here
CLAUDE_CODE_CLIENT_ID=your-claude-code-client-id-here
CHATGPT_CLIENT_ID=your-chatgpt-client-id-here
GENERIC_CLIENT_ID=your-generic-client-id-here
