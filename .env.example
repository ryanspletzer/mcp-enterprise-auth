# =============================================================================
# MCP Server with Proper Enterprise Authentication - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Entra ID (Azure AD) Configuration
# -----------------------------------------------------------------------------
# Your Microsoft Entra ID (Azure AD) tenant ID
ENTRA_TENANT_ID=12345678-1234-1234-1234-123456789abc

# Authority URL (usually no need to change)
ENTRA_AUTHORITY=https://login.microsoftonline.com/${ENTRA_TENANT_ID}

# OIDC endpoints (auto-discovered, but can be overridden)
# ENTRA_OIDC_CONFIG_URL=https://login.microsoftonline.com/${ENTRA_TENANT_ID}/v2.0/.well-known/openid-configuration
# ENTRA_JWKS_URL=https://login.microsoftonline.com/${ENTRA_TENANT_ID}/discovery/v2.0/keys

# -----------------------------------------------------------------------------
# MCP Server Identity (as a Protected Resource)
# -----------------------------------------------------------------------------
# The Application ID URI of your MCP server app registration
MCP_SERVER_APP_ID=api://mcp-server

# Alternative: Can also be the client ID GUID
# MCP_SERVER_APP_ID=87654321-4321-4321-4321-cba987654321

# Scope prefix for your MCP server
MCP_SERVER_SCOPE_PREFIX=api://mcp-server

# -----------------------------------------------------------------------------
# Authorization Requirements
# -----------------------------------------------------------------------------
# Required scope(s) for user tokens (space-separated)
# These should match the scopes exposed by your MCP server app registration
REQUIRED_SCOPE=mcp.read mcp.write

# Alternative: Check for any of these scopes (OR logic)
# REQUIRED_SCOPES_ANY=mcp.read,mcp.write

# Alternative: Require all of these scopes (AND logic)
# REQUIRED_SCOPES_ALL=mcp.read,mcp.write

# Required role(s) for service principal tokens (comma-separated)
REQUIRED_ROLE=MCP.ReadWrite.All

# Alternative: Check for any of these roles (OR logic)
# REQUIRED_ROLES_ANY=MCP.Read.All,MCP.ReadWrite.All

# -----------------------------------------------------------------------------
# Pre-registered Client IDs (from Entra ID App Registrations)
# -----------------------------------------------------------------------------
# VS Code MCP Client
VSCODE_CLIENT_ID=11111111-1111-1111-1111-111111111111

# Claude Desktop MCP Client
CLAUDE_DESKTOP_CLIENT_ID=22222222-2222-2222-2222-222222222222

# Claude Code CLI MCP Client
CLAUDE_CODE_CLIENT_ID=33333333-3333-3333-3333-333333333333

# ChatGPT MCP Client
CHATGPT_CLIENT_ID=44444444-4444-4444-4444-444444444444

# Generic/Fallback MCP Client
GENERIC_CLIENT_ID=55555555-5555-5555-5555-555555555555

# Confidential Client Example (for testing)
CONFIDENTIAL_CLIENT_ID=66666666-6666-6666-6666-666666666666
CONFIDENTIAL_CLIENT_SECRET=your-client-secret-here

# Service Principal Example (for testing)
SERVICE_PRINCIPAL_CLIENT_ID=77777777-7777-7777-7777-777777777777
SERVICE_PRINCIPAL_CLIENT_SECRET=your-service-principal-secret-here

# -----------------------------------------------------------------------------
# MCP Server Configuration
# -----------------------------------------------------------------------------
# Deployment mode: "fargate" or "agentcore"
DEPLOYMENT_MODE=fargate

# Server host and port
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000

# Base URL (used for generating redirect URIs, etc.)
MCP_SERVER_BASE_URL=http://localhost:8000

# In production Fargate, this might be:
# MCP_SERVER_BASE_URL=https://mcp-server.example.com

# In Agent Core, this might be:
# MCP_SERVER_BASE_URL=https://agentcore.example.com/mcp

# -----------------------------------------------------------------------------
# JWT Validation Configuration
# -----------------------------------------------------------------------------
# Clock skew tolerance in seconds (for exp, nbf, iat validation)
JWT_CLOCK_SKEW_SECONDS=300

# JWKS cache TTL in seconds (24 hours)
JWKS_CACHE_TTL_SECONDS=86400

# Whether to validate token version (should be "2.0" for AAD v2.0)
VALIDATE_TOKEN_VERSION=true

# Allowed token versions (comma-separated)
ALLOWED_TOKEN_VERSIONS=2.0

# Whether to enforce HTTPS for redirect URIs (disable for local dev)
ENFORCE_HTTPS_REDIRECTS=false

# -----------------------------------------------------------------------------
# Token Revocation (Optional)
# -----------------------------------------------------------------------------
# Enable token revocation checking
ENABLE_TOKEN_REVOCATION=false

# Redis connection string (if revocation enabled)
REDIS_URL=redis://localhost:6379/0

# Redis password (if required)
# REDIS_PASSWORD=your-redis-password

# Token revocation cache TTL (should match or exceed token expiration)
REVOCATION_CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# DCR (Dynamic Client Registration) Emulation
# -----------------------------------------------------------------------------
# Enable DCR endpoint
ENABLE_DCR_ENDPOINT=true

# Rate limiting for DCR requests (requests per minute per IP)
DCR_RATE_LIMIT_PER_MINUTE=10

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Allowed CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# In production, set this to your actual domains:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Enable CORS credentials
CORS_ALLOW_CREDENTIALS=true

# Allowed HTTP methods
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Allowed headers
CORS_ALLOWED_HEADERS=*

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: "json" or "text"
LOG_FORMAT=json

# Enable request/response logging (can be verbose)
LOG_REQUESTS=true

# Enable JWT claims logging (for debugging - DO NOT enable in production)
LOG_JWT_CLAIMS=false

# -----------------------------------------------------------------------------
# Performance & Scalability
# -----------------------------------------------------------------------------
# Number of Uvicorn workers (for production)
UVICORN_WORKERS=4

# Uvicorn timeout in seconds
UVICORN_TIMEOUT=60

# Maximum request size in bytes (10MB)
MAX_REQUEST_SIZE_BYTES=10485760

# -----------------------------------------------------------------------------
# Health Check Configuration
# -----------------------------------------------------------------------------
# Enable health check endpoints
ENABLE_HEALTH_CHECK=true

# Health check path
HEALTH_CHECK_PATH=/health

# Readiness check path
READINESS_CHECK_PATH=/ready

# -----------------------------------------------------------------------------
# Development / Testing Configuration
# -----------------------------------------------------------------------------
# Enable debug mode (DO NOT enable in production)
DEBUG_MODE=false

# Enable Swagger/OpenAPI documentation
ENABLE_SWAGGER=true

# Swagger UI path
SWAGGER_UI_PATH=/docs

# Enable mock authentication (for testing without Entra ID)
ENABLE_MOCK_AUTH=false

# -----------------------------------------------------------------------------
# AWS-Specific Configuration (for Fargate deployment)
# -----------------------------------------------------------------------------
# AWS region
AWS_REGION=us-east-1

# CloudWatch log group
CLOUDWATCH_LOG_GROUP=/aws/ecs/mcp-server

# Enable AWS X-Ray tracing
ENABLE_XRAY=false

# -----------------------------------------------------------------------------
# Agent Core Specific Configuration
# -----------------------------------------------------------------------------
# Agent Core API key (if required)
# AGENTCORE_API_KEY=your-api-key-here

# Agent Core endpoint prefix (if CloudFront rewriting is used)
# AGENTCORE_PATH_PREFIX=/mcp
