{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MCP Server: Run",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host", "0.0.0.0",
        "--port", "8000"
      ],
      "cwd": "${workspaceFolder}/mcp-server",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "MCP Server: Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host", "0.0.0.0",
        "--port", "8000"
      ],
      "cwd": "${workspaceFolder}/mcp-server",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Mock Entra IdP: Run",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host", "0.0.0.0",
        "--port", "8001"
      ],
      "cwd": "${workspaceFolder}/mock-entra-idp",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "pytest: MCP Server Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/",
        "-v",
        "-s"
      ],
      "cwd": "${workspaceFolder}/mcp-server",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "pytest: Client Example Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/",
        "-v",
        "-s"
      ],
      "cwd": "${workspaceFolder}/mcp-client-examples",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "pytest: Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-v",
        "-s"
      ],
      "cwd": "${workspaceFolder}/mcp-server",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Client: Public (Without Client ID)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/mcp-client-examples/public-client-without-client-id/client.py",
      "cwd": "${workspaceFolder}/mcp-client-examples/public-client-without-client-id",
      "envFile": "${workspaceFolder}/mcp-client-examples/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Client: Public (With Client ID)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/mcp-client-examples/public-client-with-client-id/client.py",
      "cwd": "${workspaceFolder}/mcp-client-examples/public-client-with-client-id",
      "envFile": "${workspaceFolder}/mcp-client-examples/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Client: Confidential",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/mcp-client-examples/confidential-client/client.py",
      "cwd": "${workspaceFolder}/mcp-client-examples/confidential-client",
      "envFile": "${workspaceFolder}/mcp-client-examples/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Client: Service Principal",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/mcp-client-examples/service-principal/client.py",
      "cwd": "${workspaceFolder}/mcp-client-examples/service-principal",
      "envFile": "${workspaceFolder}/mcp-client-examples/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: MCP Server + Mock IdP",
      "configurations": ["MCP Server: Run", "Mock Entra IdP: Run"],
      "stopAll": true
    }
  ]
}
