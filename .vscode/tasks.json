{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MCP Server: Install Dependencies",
      "type": "shell",
      "command": "uv sync --extra dev",
      "options": {
        "cwd": "${workspaceFolder}/mcp-server"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "MCP Server: Run Tests",
      "type": "shell",
      "command": "uv run pytest tests/ -v",
      "options": {
        "cwd": "${workspaceFolder}/mcp-server"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "MCP Server: Run Tests (Watch)",
      "type": "shell",
      "command": "uv run pytest-watch -- tests/ -v",
      "options": {
        "cwd": "${workspaceFolder}/mcp-server"
      },
      "group": "test",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "MCP Server: Run Tests with Coverage",
      "type": "shell",
      "command": "uv run pytest tests/ -v --cov=app --cov-report=html",
      "options": {
        "cwd": "${workspaceFolder}/mcp-server"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "MCP Server: Type Check (mypy)",
      "type": "shell",
      "command": "uv run mypy app/",
      "options": {
        "cwd": "${workspaceFolder}/mcp-server"
      },
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "MCP Server: Lint (ruff)",
      "type": "shell",
      "command": "uv run ruff check app/ tests/",
      "options": {
        "cwd": "${workspaceFolder}/mcp-server"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "MCP Server: Format (ruff)",
      "type": "shell",
      "command": "uv run ruff format app/ tests/",
      "options": {
        "cwd": "${workspaceFolder}/mcp-server"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "MCP Server: Security Check (bandit)",
      "type": "shell",
      "command": "uv run bandit -r app/ -ll",
      "options": {
        "cwd": "${workspaceFolder}/mcp-server"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "MCP Server: Run Dev Server",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/mcp-server",
        "env": {
          "DEBUG_MODE": "true"
        }
      },
      "group": "none",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Mock IdP: Run Dev Server",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8001",
      "options": {
        "cwd": "${workspaceFolder}/mock-entra-idp"
      },
      "group": "none",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Client Examples: Run Tests",
      "type": "shell",
      "command": "python -m pytest tests/ -v",
      "options": {
        "cwd": "${workspaceFolder}/mcp-client-examples"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Docker: Build All",
      "type": "shell",
      "command": "docker-compose build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Docker: Up",
      "type": "shell",
      "command": "docker-compose up -d",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Docker: Down",
      "type": "shell",
      "command": "docker-compose down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Docker: Logs",
      "type": "shell",
      "command": "docker-compose logs -f",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Full: Lint & Type Check",
      "dependsOn": [
        "MCP Server: Lint (ruff)",
        "MCP Server: Type Check (mypy)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
