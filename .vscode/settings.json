{
  // Python settings
  "python.defaultInterpreterPath": "${workspaceFolder}/mcp-server/.venv/bin/python",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.diagnosticMode": "workspace",
  // Formatting - align with pyproject.toml (black, line-length 100)
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.rulers": [
      100
    ]
  },
  // Ruff settings (replaces black, isort, flake8)
  "ruff.lineLength": 100,
  "ruff.lint.args": [
    "--config=${workspaceFolder}/mcp-server/pyproject.toml"
  ],
  "ruff.format.args": [
    "--config=${workspaceFolder}/mcp-server/pyproject.toml"
  ],
  // Testing
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "mcp-server/tests",
    "-v"
  ],
  // Editor settings
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  // File associations
  "files.associations": {
    "*.env*": "dotenv",
    "Dockerfile*": "dockerfile",
    "*.md": "markdown"
  },
  // Exclude from search/watch
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/htmlcov/**": true,
    "**/.coverage": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/htmlcov/**": true,
    "**/*.lock": true
  },
  // Markdown settings
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "editor.formatOnSave": true,
    "editor.wordWrap": "on",
    "editor.rulers": [
      80,
      100,
      114,
      116,
      120
    ]
  },
  "markdownlint.config": {
    "MD013": false,
    "MD033": false,
    "MD041": false
  },
  // JSON settings
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  // YAML settings
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true
  },
  // Docker settings
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  // Terminal settings
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.env.osx": {
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "terminal.integrated.env.linux": {
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  // Git settings
  "git.ignoreLimitWarning": true,
  "git.autofetch": true
}
